---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { guides } from '../../data/guides';
import { videos, ytThumb } from '../../data/adventures';
import { getLang, localize } from '../../i18n';

const lang = getLang(Astro.url);
const l = (p: string) => localize(p, lang);
const copy = {
  en: {
    title: 'Travel guides — Jumman', desc: 'Route guides for the hikes and trips from the Jumman Footprints films.',
    eyebrow: 'Travel guides', h1: 'Walk it yourself.',
    lede: 'The routes from the films, written up so you can do them too: maps, public transport, timings and what to pack. In English and Bangla.',
    ready: 'PDF ready', soon: 'Coming soon', open: 'View guide →',
  },
  bn: {
    title: 'ট্রাভেল গাইড — জুম্মান', desc: 'জুম্মান ফুটপ্রিন্টস ফিল্মের হাইক আর যাত্রার পথনির্দেশিকা।',
    eyebrow: 'ট্রাভেল গাইড', h1: 'নিজেই হেঁটে দেখুন।',
    lede: 'ফিল্মের পথগুলো লিখে রাখা, যাতে আপনিও যেতে পারেন: মানচিত্র, পাবলিক ট্রান্সপোর্ট, সময় আর কী নেবেন। ইংরেজি আর বাংলায়।',
    ready: 'PDF তৈরি', soon: 'শিগগিরই আসছে', open: 'গাইড দেখুন →',
  },
}[lang];
const cover = (g: (typeof guides)[number]) => {
  if (g.cover) return { src: g.cover };
  const v = videos.find((x) => x.slug === g.videos[0]);
  return v ? { src: ytThumb(v.youtubeId), fallback: ytThumb(v.youtubeId, 'hqdefault') } : {};
};
---
<Base title={copy.title} active="guides" description={copy.desc}>
  <div class="container page" style="gap: 48px">
    <header class="stack" style="gap: 16px; max-width: 760px">
      <div class="eyebrow">{copy.eyebrow}</div>
      <h1 class="display">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <div class="grid-auto" style="gap: 28px 24px">
      {guides.map((g) => {
        const c = cover(g);
        const ready = !!(g.pdf?.en || g.pdf?.bn);
        return (
          <a href={l(`/guides/${g.slug}/`)} class="card stack">
            <div class="cover">
              <Media label={g.title[lang]} ratio="16 / 9" radius="16px" src={c.src} fallback={c.fallback} alt="" />
              <span class:list={['badge', { ready }]}>{ready ? copy.ready : copy.soon}</span>
            </div>
            <div class="meta">{g.place[lang]}</div>
            <h2 class="title">{g.title[lang]}</h2>
            <p class="muted summary">{g.summary[lang]}</p>
            <span class="go">{copy.open}</span>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .card { gap: 12px; color: var(--text); }
  .card:hover { color: var(--text); }
  .card:hover .title, .card:hover .go { color: var(--amber); }
  .cover { position: relative; }
  .badge { position: absolute; top: 14px; right: 14px; z-index: 2; font-family: var(--font-mono); font-size: 12px; padding: 4px 10px; border-radius: 999px; background: rgba(0,0,0,.7); color: var(--muted); }
  .badge.ready { background: var(--amber); color: var(--on-amber); }
  .title { font-size: 24px; font-weight: 500; letter-spacing: -.01em; line-height: 1.25; transition: color .15s; }
  .summary { font-size: 16px; line-height: 1.6; }
  .go { font-size: 15px; color: var(--muted); }
</style>

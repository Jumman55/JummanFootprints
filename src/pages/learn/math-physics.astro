---
import Base from '../../layouts/Base.astro';
import { lessons, stages } from '../../data/lessons';
import { getLang, localize, digits } from '../../i18n';

const lang = getLang(Astro.url);
const l = (p: string) => localize(p, lang);
const copy = {
  en: {
    title: 'Learn: Math & Physics — Jumman', desc: 'An interactive trail of lessons from π to the Schrödinger equation.',
    back: '← Learn', eyebrow: 'Math & Physics', h1a: 'A trail from ', h1b: ' to ', h1c: '.',
    lede: 'Start at the bottom and climb. Each stage builds on the one before, from the geometry of a circle to the equation that describes the quantum world. Every lesson is interactive: drag, slide, answer, and move on.',
    start: 'Start the trail', maths: 'Maths', physics: 'Physics', min: 'min', done: 'Done', inProgress: 'In progress',
  },
  bn: {
    title: 'শিখুন: গণিত ও পদার্থবিজ্ঞান — জুম্মান', desc: 'π থেকে শ্রোডিঙ্গার সমীকরণ পর্যন্ত ইন্টারঅ্যাকটিভ পাঠের একটি পথ।',
    back: '← শিখুন', eyebrow: 'গণিত ও পদার্থবিজ্ঞান', h1a: '', h1b: ' থেকে ', h1c: ' পর্যন্ত এক পথ।',
    lede: 'নিচ থেকে শুরু করে ওপরে উঠুন। প্রতিটি ধাপ আগেরটির ওপর দাঁড়িয়ে, বৃত্তের জ্যামিতি থেকে কোয়ান্টাম জগতের সমীকরণ পর্যন্ত। প্রতিটি পাঠ ইন্টারঅ্যাকটিভ: টানুন, স্লাইড করুন, উত্তর দিন, এগিয়ে যান।',
    start: 'পথ শুরু করুন', maths: 'গণিত', physics: 'পদার্থবিজ্ঞান', min: 'মিনিট', done: 'শেষ', inProgress: 'চলছে',
  },
}[lang];
---
<Base title={copy.title} active="learn" description={copy.desc}>
  <div class="container page page-tight" style="gap: 56px">
    <header class="stack" style="gap: 16px; max-width: 780px">
      <a href={l('/learn/')} class="back-link">{copy.back}</a>
      <div class="eyebrow eyebrow-amber">{copy.eyebrow}</div>
      <h1 class="display" style="font-size: clamp(40px, 6.5vw, 80px)">{copy.h1a}<span class="serif-i" style="font-weight: 400">π</span>{copy.h1b}<span class="serif-i" style="font-weight: 400">ψ</span>{copy.h1c}</h1>
      <p class="lede">{copy.lede}</p>
      <a href={l(`/learn/${lessons[0].slug}/`)} class="btn btn-primary" style="align-self: flex-start; margin-top: 8px">{copy.start} →</a>
    </header>

    <ol class="trail">
      {stages.map((s, i) => (
        <li>
          <div class="rail">
            <span class="num">{digits(String(s.n).padStart(2, '0'), lang)}</span>
            {i < stages.length - 1 && <span class="line" aria-hidden="true"></span>}
          </div>
          <div class="stack" style="padding: 6px 0 44px; gap: 14px; min-width: 0">
            <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px">
              <h2 style="font-size: 26px; font-weight: 500; letter-spacing: -.02em">{s.title[lang]}</h2>
              <span class="serif-i dim" style="font-size: 20px">{s.formula}</span>
            </div>
            <div class="cards">
              {lessons.filter((x) => x.stage === s.n).map((x) => (
                <a href={l(`/learn/${x.slug}/`)} class="panel lcard" data-progress={x.slug} data-steps={x.steps.length}>
                  <span style="font-size: 19px; line-height: 1.35">{x.title[lang]}</span>
                  <span class="dim small">{x.standfirst[lang]}</span>
                  <span class="lmeta">
                    <span>{x.kind === 'maths' ? copy.maths : copy.physics} · {digits(x.minutes, lang)} {copy.min}</span>
                    <span class="status" data-done={copy.done} data-doing={copy.inProgress}></span>
                  </span>
                  <span class="mini"><span></span></span>
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<script>
  // Show each lesson's saved progress on its card.
  document.querySelectorAll<HTMLElement>('[data-progress]').forEach((card) => {
    let n = -1;
    try { const v = localStorage.getItem(`lesson:${card.dataset.progress}`); if (v !== null) n = Number(v); } catch {}
    if (n < 0) return;
    const total = Number(card.dataset.steps);
    const done = n >= total - 1;
    const status = card.querySelector<HTMLElement>('.status')!;
    status.textContent = done ? `✓ ${status.dataset.done}` : status.dataset.doing!;
    status.classList.toggle('ok', done);
    card.querySelector<HTMLElement>('.mini span')!.style.width = `${((n + 1) / total) * 100}%`;
    card.classList.add('started');
  });
</script>

<style>
  .trail { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .trail li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 24px; }
  .rail { display: flex; flex-direction: column; align-items: center; }
  .num { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--amber); color: var(--amber); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 13px; flex: 0 0 auto; }
  .line { flex: 1 1 auto; width: 0; border-left: 1px dashed rgba(242,178,62,.4); margin: 6px 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .lcard { display: flex; flex-direction: column; gap: 10px; border-radius: 14px; padding: 20px 22px; color: var(--text); }
  .lcard:hover { border-color: rgba(242,178,62,.4); color: var(--text); }
  .small { font-size: 15px; line-height: 1.5; }
  .lmeta { display: flex; justify-content: space-between; gap: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--dim); margin-top: auto; }
  .status { color: var(--amber); }
  .status.ok { color: #7FB2E5; }
  .mini { height: 3px; border-radius: 2px; background: var(--raised); overflow: hidden; display: none; }
  .started .mini { display: block; }
  .mini span { display: block; height: 100%; width: 0; background: var(--amber); }
  @media (max-width: 600px) { .trail li { grid-template-columns: 44px minmax(0, 1fr); gap: 14px; } }
</style>

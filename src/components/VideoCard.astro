---
import Media from './Media.astro';
import { ytThumb, type Video } from '../data/adventures';
import { getLang, localize, monthYear, ui } from '../i18n';
interface Props { video: Video; ratio?: string }
const { video: v, ratio = '16 / 9' } = Astro.props;
const lang = getLang(Astro.url);
---
<a href={localize(`/adventures/${v.slug}/`, lang)} class="card stack">
  <div class="thumb">
    <Media label={v.title[lang]} ratio={ratio} play src={ytThumb(v.youtubeId)} fallback={ytThumb(v.youtubeId, 'hqdefault')} alt="" />
    <span class="dur">{v.duration}</span>
  </div>
  <div class="meta">{monthYear(v.date, lang)} · {v.place[lang]}</div>
  <h3 class="title">{v.title[lang]}</h3>
  <div class="tags">{v.tags.map((t) => <span class="tag">{ui[lang].tags[t]}</span>)}</div>
</a>

<style>
  .card { gap: 14px; color: var(--text); }
  .card:hover { color: var(--text); }
  .card:hover .title { color: var(--amber); }
  .thumb { position: relative; border-radius: 16px; overflow: hidden; }
  .dur { position: absolute; right: 12px; bottom: 12px; z-index: 2; font-family: var(--font-mono); font-size: 12px; background: rgba(0,0,0,.75); color: #fff; padding: 2px 8px; border-radius: 6px; }
  .title { font-size: 22px; font-weight: 500; letter-spacing: -.01em; line-height: 1.3; transition: color .15s; }
</style>

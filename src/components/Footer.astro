---
import { site, navLinks } from '../data/site';
import { getLang, localize, ui } from '../i18n';
const lang = getLang(Astro.url);
const t = ui[lang];
---
<footer class="footer">
  <div class="container inner">
    <div class="cols">
      <div class="stack" style="gap: 14px; min-width: 0">
        <span class="dot-display" style="font-size: 34px; letter-spacing: .04em">{site.name}</span>
        <p class="muted" style="font-size: 16px; line-height: 1.6; max-width: 360px">{t.footerBlurb}</p>
      </div>
      <nav aria-label="Footer" class="col">
        <div class="eyebrow col-head">{t.explore}</div>
        {navLinks.map((l) => <a href={localize(l.href, lang)}>{t.nav[l.id]}</a>)}
      </nav>
      <div class="col">
        <div class="eyebrow col-head">{t.elsewhere}</div>
        <a href={site.social.youtube} rel="noopener" target="_blank">YouTube ↗</a>
        <a href={site.social.instagram} rel="noopener" target="_blank">Instagram ↗</a>
        <a href={site.social.facebook} rel="noopener" target="_blank">Facebook ↗</a>
        <a href={localize('/', lang) + '#newsletter'}>{t.newsletter}</a>
      </div>
    </div>
    <div class="base">
      <span>{t.footerNote}</span>
      <span>{t.builtWith}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--deep); border-top: 1px solid var(--hairline); }
  .inner { padding-top: 64px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 48px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; }
  .col { display: flex; flex-direction: column; gap: 2px; }
  .col-head { margin-bottom: 8px; }
  .col a { font-size: 15px; padding: 8px 0; align-self: flex-start; }
  .base { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; border-top: 1px solid var(--hairline-soft); padding-top: 24px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; color: var(--dim); }
</style>

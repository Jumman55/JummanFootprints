---
// Page for a single YouTube adventure. Used by /adventures/[slug] and /bn/adventures/[slug].
import Base from '../layouts/Base.astro';
import Media from './Media.astro';
import VideoCard from './VideoCard.astro';
import { site } from '../data/site';
import { videos, ytThumb, ytWatch, type Video } from '../data/adventures';
import { getLang, localize, fullDate, digits, ui } from '../i18n';

interface Props { video: Video }
const { video: v } = Astro.props;
const lang = getLang(Astro.url);
const l = (p: string) => localize(p, lang);
const t = ui[lang];

const i = videos.indexOf(v);
const newer = videos[i - 1];
const older = videos[i + 1];
const seriesParts = v.series ? videos.filter((x) => x.series?.id === v.series!.id).sort((a, b) => a.series!.part - b.series!.part) : [];
const related = videos.filter((x) => x !== v && !seriesParts.includes(x) && x.tags.some((tg) => v.tags.includes(tg))).slice(0, 3);

const copy = {
  en: {
    back: '← All adventures', date: 'Published', place: 'Place', length: 'Length', about: 'About this film',
    chapters: 'Chapters', jump: 'Opens YouTube at this moment', series: 'The series', part: 'Part', youAreHere: 'You are here',
    older: '← Older', newer: 'Newer →', related: 'More like this', play: 'Play video', subs: 'Narrated in Bangla · English subtitles on YouTube',
  },
  bn: {
    back: '← সব অভিযান', date: 'প্রকাশিত', place: 'জায়গা', length: 'দৈর্ঘ্য', about: 'ফিল্মটি সম্পর্কে',
    chapters: 'অধ্যায়', jump: 'এই মুহূর্ত থেকে YouTube-এ খুলবে', series: 'সিরিজ', part: 'পর্ব', youAreHere: 'আপনি এখানে',
    older: '← পুরোনো', newer: 'নতুন →', related: 'এরকম আরও', play: 'ভিডিও চালান', subs: 'বাংলায় বলা · YouTube-এ ইংরেজি সাবটাইটেল',
  },
}[lang];
---
<Base title={`${v.title[lang]} — ${lang === 'bn' ? 'জুম্মান' : 'Jumman'}`} active="adventures" description={v.summary[lang]} image={ytThumb(v.youtubeId)}>
  <article>
    <header class="container stack" style="padding-top: 56px; padding-bottom: 32px; gap: 20px">
      <a href={l('/adventures/')} class="back-link">{copy.back}</a>
      <div class="tags">{v.tags.map((tg, k) => <span class:list={['tag', { 'tag-on': k === 0 }]}>{t.tags[tg]}</span>)}</div>
      <h1 style="font-size: clamp(34px, 5.5vw, 64px); font-weight: 500; letter-spacing: -.03em; line-height: 1.08; max-width: 980px">{v.title[lang]}</h1>
      <p lang={lang === 'en' ? 'bn' : 'en'} class="muted" style="font-size: clamp(17px, 2vw, 21px)">{v.title[lang === 'en' ? 'bn' : 'en']}</p>
      <dl class="facts">
        <div><dt>{copy.date}</dt><dd>{fullDate(v.date, lang)}</dd></div>
        <div><dt>{copy.place}</dt><dd>{v.place[lang]}</dd></div>
        <div><dt>{copy.length}</dt><dd>{digits(v.duration, lang)}</dd></div>
        {v.facts?.map((f) => <div><dt>{f.label[lang]}</dt><dd>{f.value[lang]}</dd></div>)}
      </dl>
    </header>

    <section aria-label="Video" class="container stack" style="gap: 16px">
      <div class="video" data-yt={v.youtubeId} data-title={v.title[lang]}>
        <button type="button" class="video-btn" aria-label={`${copy.play}: ${v.title[lang]}`}>
          <Media label={v.title[lang]} play eager src={ytThumb(v.youtubeId)} fallback={ytThumb(v.youtubeId, 'hqdefault')} alt="" />
        </button>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between">
        <span class="dim" style="font-size: 14px">{v.place[lang]}</span>
        <a href={ytWatch(v.youtubeId)} class="pill" rel="noopener" target="_blank">{t.watchOnYouTube} ↗</a>
      </div>
    </section>

    <div class="container body-wrap">
      <div class="stack" style="flex: 999 1 560px; min-width: 0; gap: 56px">
        <section class="stack" style="gap: 18px">
          <h2 class="label">{copy.about}</h2>
          <p class="prose">{v.summary[lang]}</p>
        </section>

        {v.chapters && (
          <section class="stack" style="gap: 18px">
            <h2 class="label">{copy.chapters}</h2>
            <ol class="row-list chapters">
              {v.chapters.map((c) => (
                <li>
                  <a href={ytWatch(v.youtubeId, c.t)} rel="noopener" target="_blank" title={copy.jump}>
                    <span class="ts">{digits(c.t, lang)}</span><span>{c[lang]}</span><span class="dim" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      {seriesParts.length > 1 && (
        <aside class="stack" style="flex: 1 1 300px; min-width: 0; gap: 12px">
          <h2 class="label">{copy.series}</h2>
          {seriesParts.map((p) => (
            p === v
              ? <div class="panel part on"><span class="meta">{copy.part} {digits(p.series!.part, lang)} · {copy.youAreHere}</span><span>{p.title[lang]}</span></div>
              : <a href={l(`/adventures/${p.slug}/`)} class="outline part"><span class="meta">{copy.part} {digits(p.series!.part, lang)}</span><span>{p.title[lang]}</span></a>
          ))}
        </aside>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="container stack" style="gap: 28px; padding-top: 96px">
      <div class="section-head"><h2 class="h-section">{copy.related}</h2></div>
      <div class="grid-auto">{related.map((r) => <VideoCard video={r} />)}</div>
    </section>
  )}

  <nav aria-label="More adventures" class="container pager">
    {older ? <a href={l(`/adventures/${older.slug}/`)} class="outline pg"><span class="meta">{copy.older}</span><span style="font-size: 19px">{older.title[lang]}</span></a> : <span></span>}
    {newer && <a href={l(`/adventures/${newer.slug}/`)} class="outline pg" style="align-items: flex-end; text-align: right"><span class="meta">{copy.newer}</span><span style="font-size: 19px">{newer.title[lang]}</span></a>}
  </nav>
</Base>

<script>
  // Click-to-load YouTube: no third-party requests until the visitor presses play.
  document.querySelectorAll<HTMLElement>('.video[data-yt]').forEach((box) => {
    const btn = box.querySelector('.video-btn');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&cc_load_policy=1&rel=0`;
      f.title = box.dataset.title ?? 'YouTube video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>

<style>
  .facts { margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: 16px; overflow: hidden; }
  .facts > div { background: var(--ground); padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .facts dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
  :global(html[lang='bn']) .facts dt { letter-spacing: 0; font-size: 13px; }
  .facts dd { margin: 0; font-size: 16px; line-height: 1.4; }
  .video { border-radius: 16px; overflow: hidden; }
  .video :global(iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
  .video-btn { all: unset; display: block; width: 100%; cursor: pointer; }
  .video-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .body-wrap { padding-top: 72px; display: flex; flex-wrap: wrap; gap: 56px; }
  .prose { font-size: 19px; line-height: 1.75; color: var(--body); max-width: 680px; }
  .chapters { margin: 0; padding: 0; list-style: none; }
  .chapters a { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 16px; padding: 14px 0; font-size: 17px; align-items: baseline; }
  .ts { font-family: var(--font-mono); font-size: 13px; color: var(--amber); }
  .part { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 14px; font-size: 17px; line-height: 1.35; }
  .part.on { border-color: rgba(242,178,62,.4); }
  .pager { padding-top: 96px; padding-bottom: 120px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 24px; }
  .pg { display: flex; flex-direction: column; gap: 8px; padding: 24px; border-radius: 16px; }
</style>

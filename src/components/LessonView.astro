---
// An interactive lesson: steps unlock one at a time, quizzes check answers, progress is remembered.
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import CircleRoll from './widgets/CircleRoll.astro';
import PolygonPi from './widgets/PolygonPi.astro';
import UnitCircle from './widgets/UnitCircle.astro';
import Derivative from './widgets/Derivative.astro';
import ComplexPlane from './widgets/ComplexPlane.astro';
import StringWave from './widgets/StringWave.astro';
import DoubleSlit from './widgets/DoubleSlit.astro';
import ParticleBox from './widgets/ParticleBox.astro';
import WavePacket from './widgets/WavePacket.astro';
import { lessons, stages, type Lesson } from '../data/lessons';
import { rich, richInline } from '../lib/rich';
import { getLang, localize, digits } from '../i18n';

interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const lang = getLang(Astro.url);
const l = (p: string) => localize(p, lang);
const idx = lessons.indexOf(lesson);
const prev = lessons[idx - 1];
const next = lessons[idx + 1];
const stage = stages.find((s) => s.n === lesson.stage)!;
const widgets = { circle: CircleRoll, polygon: PolygonPi, trig: UnitCircle, derivative: Derivative, complex: ComplexPlane, string: StringWave, slit: DoubleSlit, box: ParticleBox, packet: WavePacket };

const copy = {
  en: {
    back: 'Math & Physics', stage: 'Stage', min: 'min', steps: 'steps', contents: 'In this lesson',
    cont: 'Continue', check: 'Check', answer: 'Your answer', correct: 'Correct!', wrong: 'Not quite. Have another go.',
    reset: 'Start again', done: 'Lesson complete', nextL: 'Next lesson', prevL: 'Previous lesson', end: 'Back to the trail',
    maths: 'MATHS', physics: 'PHYSICS', progress: 'Lesson progress',
  },
  bn: {
    back: 'গণিত ও পদার্থবিজ্ঞান', stage: 'ধাপ', min: 'মিনিট', steps: 'অংশ', contents: 'এই পাঠে',
    cont: 'এগিয়ে যান', check: 'যাচাই করুন', answer: 'আপনার উত্তর', correct: 'সঠিক!', wrong: 'ঠিক হয়নি। আবার চেষ্টা করুন।',
    reset: 'আবার শুরু করুন', done: 'পাঠ শেষ', nextL: 'পরের পাঠ', prevL: 'আগের পাঠ', end: 'পথে ফিরে যান',
    maths: 'গণিত', physics: 'পদার্থবিজ্ঞান', progress: 'পাঠের অগ্রগতি',
  },
}[lang];
const sections = lesson.steps.map((s, i) => ({ i, title: s.title?.[lang] })).filter((s) => s.title);
---
<Base title={`${lesson.title[lang]} — ${lang === 'bn' ? 'জুম্মান' : 'Jumman'}`} active="learn" description={lesson.standfirst[lang]}>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="container lesson-wrap">
    <aside class="toc" aria-label={copy.contents}>
      <div class="eyebrow" style="margin-bottom: 10px">{copy.contents}</div>
      {sections.map((s) => <a href={`#step-${s.i + 1}`} data-toc={s.i}>{s.title}</a>)}
      <button type="button" class="reset" data-reset>{copy.reset}</button>
    </aside>

    <article class="col" data-lesson={lesson.slug} data-correct={copy.correct} data-wrong={copy.wrong}>
      <header class="stack head">
        <a href={l('/learn/math-physics/')} class="back-link">← {copy.back} · {copy.stage} {digits(String(lesson.stage).padStart(2, '0'), lang)}</a>
        <h1>{lesson.title[lang]}</h1>
        <p class="standfirst">{lesson.standfirst[lang]}</p>
        <div class="meta-row">
          <span>{lesson.kind === 'maths' ? copy.maths : copy.physics}</span>
          <span>{stage.title[lang]}</span>
          <span>{digits(lesson.minutes, lang)} {copy.min}</span>
          <span>{digits(lesson.steps.length, lang)} {copy.steps}</span>
        </div>
        <div class="bar" role="progressbar" aria-label={copy.progress} aria-valuemin="0" aria-valuemax={lesson.steps.length} aria-valuenow="1"><span data-bar></span></div>
      </header>

      {lesson.steps.map((step, i) => {
        const W = step.widget ? widgets[step.widget] : null;
        const q = step.quiz;
        const last = i === lesson.steps.length - 1;
        return (
          <section class="step" id={`step-${i + 1}`} data-step={i} data-gate={q ? 'quiz' : last ? 'end' : 'continue'}>
            {step.title && <h2>{step.title[lang]}</h2>}
            <div class="prose" set:html={rich(step.body[lang])} />
            {W && <W lang={lang} />}
            {q && (
              <div class="quiz" data-kind={q.kind} data-answer={q.kind === 'number' ? q.answer : undefined} data-tol={q.kind === 'number' ? q.tol : undefined}>
                <p class="q" set:html={richInline(q.q[lang])} />
                {q.kind === 'choice' ? (
                  <div class="options">
                    {q.options.map((o) => <button type="button" class="opt" data-correct={o.correct ? '1' : undefined} set:html={richInline(o.t[lang])} />)}
                  </div>
                ) : (
                  <form class="num" data-num>
                    <label class="sr-only" for={`a-${i}`}>{copy.answer}</label>
                    <input id={`a-${i}`} inputmode="decimal" autocomplete="off" placeholder="?" class="input" />
                    {q.unit && <span class="unit">{q.unit}</span>}
                    <button type="submit" class="btn btn-primary">{copy.check}</button>
                  </form>
                )}
                <p class="feedback" aria-live="polite" data-feedback></p>
                <div class="explain" hidden set:html={rich(q.explain[lang])} />
              </div>
            )}
            {!q && !last && <button type="button" class="btn continue" data-continue>{copy.cont} ↓</button>}
            {last && (
              <div class="finish">
                <div class="eyebrow eyebrow-amber">✓ {copy.done}</div>
                <div class="finish-links">
                  {next
                    ? <a href={l(`/learn/${next.slug}/`)} class="panel next-card"><span class="meta">{copy.nextL} →</span><span style="font-size: 20px">{next.title[lang]}</span></a>
                    : <a href={l('/learn/math-physics/')} class="panel next-card"><span class="meta">{copy.end} →</span><span style="font-size: 20px">{copy.back}</span></a>}
                </div>
              </div>
            )}
          </section>
        );
      })}

      <nav class="pager" aria-label={copy.contents}>
        {prev ? <a href={l(`/learn/${prev.slug}/`)} class="outline pg"><span class="pg-k">← {copy.prevL}</span><span>{prev.title[lang]}</span></a> : <span></span>}
        {next && <a href={l(`/learn/${next.slug}/`)} class="outline pg" style="align-items: flex-end; text-align: right"><span class="pg-k">{copy.nextL} →</span><span>{next.title[lang]}</span></a>}
      </nav>
    </article>
  </div>
</Base>

<script>
  document.documentElement.classList.add('js');
  const art = document.querySelector<HTMLElement>('[data-lesson]')!;
  const steps = [...art.querySelectorAll<HTMLElement>('.step')];
  const key = `lesson:${art.dataset.lesson}`;
  const bar = art.querySelector<HTMLElement>('[data-bar]')!;
  const progress = art.querySelector<HTMLElement>('[role=progressbar]')!;
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  let unlocked = 0;
  try { unlocked = Math.min(steps.length - 1, Number(localStorage.getItem(key) ?? 0)); } catch {}

  const toBase = (s: string) => s.replace(/[০-৯]/g, (d) => String('০১২৩৪৫৬৭৮৯'.indexOf(d))).replace(/,/g, '').replace(/\s/g, '').replace('−', '-');

  function solve(step: HTMLElement) {
    const quiz = step.querySelector<HTMLElement>('.quiz');
    if (!quiz) return;
    quiz.classList.add('solved');
    quiz.querySelector<HTMLElement>('.explain')!.hidden = false;
    quiz.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => { b.disabled = true; if (b.dataset.correct) b.classList.add('right'); });
    const inp = quiz.querySelector<HTMLInputElement>('input');
    if (inp) { inp.disabled = true; if (!inp.value) inp.value = quiz.dataset.answer!; }
    quiz.querySelector<HTMLButtonElement>('button[type=submit]')?.setAttribute('disabled', '');
    quiz.querySelector('[data-feedback]')!.textContent = art.dataset.correct!;
  }

  function render(scrollTo?: number) {
    steps.forEach((s, i) => {
      s.classList.toggle('locked', i > unlocked);
      s.querySelector('[data-continue]')?.toggleAttribute('hidden', i < unlocked);
      if (i < unlocked) solve(s);
    });
    const pct = ((unlocked + 1) / steps.length) * 100;
    bar.style.width = `${pct}%`;
    progress.setAttribute('aria-valuenow', String(unlocked + 1));
    tocLinks.forEach((a) => a.classList.toggle('locked', Number(a.dataset.toc) > unlocked));
    try { localStorage.setItem(key, String(unlocked)); } catch {}
    if (scrollTo !== undefined) {
      const el = steps[scrollTo];
      requestAnimationFrame(() => el.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }));
    }
  }

  function advance(from: number) {
    if (from < unlocked) return;
    unlocked = Math.min(steps.length - 1, from + 1);
    steps[unlocked].classList.add('reveal');
    render(unlocked);
  }

  steps.forEach((step, i) => {
    step.querySelector('[data-continue]')?.addEventListener('click', () => advance(i));
    const quiz = step.querySelector<HTMLElement>('.quiz');
    if (!quiz) return;
    const fb = quiz.querySelector<HTMLElement>('[data-feedback]')!;
    const wrong = (node?: HTMLElement) => {
      fb.textContent = art.dataset.wrong!;
      quiz.classList.remove('shake'); void quiz.offsetWidth; quiz.classList.add('shake');
      node?.classList.add('wrong');
    };
    quiz.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.correct) { solve(step); setTimeout(() => advance(i), 900); }
        else { wrong(b); b.disabled = true; }
      })
    );
    quiz.querySelector<HTMLFormElement>('[data-num]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const inp = quiz.querySelector<HTMLInputElement>('input')!;
      const v = Number(toBase(inp.value));
      if (inp.value.trim() !== '' && Math.abs(v - Number(quiz.dataset.answer)) <= Number(quiz.dataset.tol)) {
        solve(step); setTimeout(() => advance(i), 900);
      } else wrong(inp);
    });
  });

  // Highlight the section in view.
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const n = Number((e.target as HTMLElement).dataset.step);
      let active = -1;
      tocLinks.forEach((a) => { if (Number(a.dataset.toc) <= n) active = Number(a.dataset.toc); });
      tocLinks.forEach((a) => a.classList.toggle('on', Number(a.dataset.toc) === active));
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  steps.forEach((s) => obs.observe(s));

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    try { localStorage.removeItem(key); } catch {}
    location.hash = '';
    location.reload();
  });

  render();
</script>

<style>
  .lesson-wrap { padding-top: 56px; padding-bottom: 120px; display: flex; gap: 64px; justify-content: center; align-items: flex-start; }
  .toc { flex: 0 0 220px; position: sticky; top: 110px; display: flex; flex-direction: column; gap: 2px; padding-top: 260px; }
  .toc a { min-height: 38px; display: flex; align-items: center; color: var(--muted); font-size: 15px; border-left: 2px solid var(--hairline); padding-left: 14px; line-height: 1.3; }
  .toc a.on { color: var(--amber); border-left-color: var(--amber); }
  :global(html.js) .toc a.locked { color: #4d4944; pointer-events: none; }
  .reset { margin-top: 18px; align-self: flex-start; background: none; border: 0; color: var(--dim); font-size: 13px; cursor: pointer; padding: 6px 0; text-decoration: underline; text-underline-offset: 3px; }
  .reset:hover { color: var(--amber); }
  .col { flex: 1 1 auto; max-width: 720px; min-width: 0; display: flex; flex-direction: column; }
  .head { gap: 18px; padding-bottom: 28px; margin-bottom: 12px; border-bottom: 1px solid var(--hairline); }
  .head h1 { font-size: clamp(34px, 5.5vw, 58px); font-weight: 500; letter-spacing: -.03em; line-height: 1.08; }
  .standfirst { font-family: var(--font-serif); font-size: 23px; line-height: 1.55; color: var(--muted); }
  .meta-row { display: flex; flex-wrap: wrap; gap: 8px 20px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; color: var(--dim); text-transform: uppercase; }
  .bar { height: 4px; border-radius: 2px; background: var(--raised); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--amber); transition: width .4s ease; }
  :global(html:not(.js)) .bar { display: none; }

  .step { display: flex; flex-direction: column; gap: 22px; padding: 28px 0 12px; scroll-margin-top: 90px; }
  .step.reveal { animation: rise .45s ease both; }
  :global(html.js) .step.locked { display: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .step h2 { font-size: 28px; font-weight: 500; letter-spacing: -.02em; margin-top: 12px; }
  .prose { display: flex; flex-direction: column; gap: 18px; }
  .prose :global(p) { font-family: var(--font-serif); font-size: 21px; line-height: 1.7; color: var(--prose); margin: 0; }
  :global(html[lang='bn']) .prose :global(p) { font-size: 20px; line-height: 1.85; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(.math-display) { font-size: 20px; color: var(--text); background: var(--surface); border: 1px solid var(--hairline); border-radius: 14px; padding: 16px 12px; }
  .continue { align-self: flex-start; margin-top: 4px; }
  :global(html:not(.js)) .continue { display: none; }

  .quiz { border: 1px solid rgba(242,178,62,.35); background: rgba(242,178,62,.05); border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .quiz.solved { border-color: rgba(127,178,229,.45); background: rgba(127,178,229,.06); }
  .quiz.shake { animation: shake .35s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 50% { transform: translateX(6px); } 75% { transform: translateX(-3px); } }
  .q { margin: 0; font-size: 18px; line-height: 1.5; }
  .options { display: flex; flex-direction: column; gap: 8px; }
  .opt { text-align: left; min-height: 48px; padding: 10px 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,.16); background: var(--ground); color: var(--text); font-family: var(--font-sans); font-size: 16px; cursor: pointer; }
  .opt:hover:not(:disabled) { border-color: var(--amber); }
  .opt.wrong { border-color: rgba(230,110,90,.6); color: var(--dim); text-decoration: line-through; }
  .opt.right { border-color: #7FB2E5; background: rgba(127,178,229,.12); }
  .opt:disabled { cursor: default; }
  .num { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .num .input { flex: 0 1 180px; min-height: 48px; font-family: var(--font-mono); font-size: 17px; }
  .num .input.wrong { border-color: rgba(230,110,90,.7); }
  .unit { font-family: var(--font-mono); color: var(--muted); }
  .feedback { margin: 0; min-height: 1em; font-size: 15px; color: var(--amber); }
  .solved .feedback { color: #7FB2E5; }
  .explain :global(p) { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .finish { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
  .next-card { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; border-radius: 16px; color: var(--text); }
  .next-card:hover { border-color: rgba(242,178,62,.4); color: var(--text); }
  .pager { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 12px; margin-top: 64px; }
  .pg { display: flex; flex-direction: column; gap: 6px; border-radius: 14px; padding: 18px 20px; font-size: 17px; }
  .pg-k { font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; color: var(--dim); text-transform: uppercase; }
  @media (max-width: 960px) { .toc { display: none; } }
  @media (prefers-reduced-motion: reduce) { .step.reveal { animation: none; } .quiz.shake { animation: none; } }
</style>
